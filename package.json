{
  "name": "@hugsmidjan/hxmstyle",
  "description": "One annoying style to rule them all...",
  "version": "11.2.0",
  "main": "index.js",
  "bin": {
    "hxmstyle": "bin/installer.cjs"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "type": "module",
  "scripts": {
    "dogfood": "yarn upgrade @hugsmidjan/hxmstyle && hxmstyle && yarn run format",
    "format": "eslint --fix  \"*.js\" \"**/*.js\"  &&  prettier --write --log-level=error  \"*.md\" \"*.json\""
  },
  "exports": {
    ".": "./index.js",
    "./prettier": "./prettier.js"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-destructure-depth": "^1.0.3",
    "eslint-plugin-destructuring": "^2.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node-import": "^1.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.10.1"
  },
  "optionals": {
    "scss": {
      "stylelint": "^17.16.0",
      "stylelint-order": "^8.1.3",
      "stylelint-prettier": "^5.1.0",
      "stylelint-scss": "^7.5.0",
      "postcss-scss": "^4.0.9"
    }
  },
  "repository": "git@github.com:hugsmidjan/hxmstyle.git",
  "author": "Hugsmiðjan ehf (https://www.hugsmidjan.is)",
  "contributors": [
    "Már Örlygsson <mar.nospam@anomy.net>",
    "Valur Sverrison <valur@hugsmidjan.is>",
    "Mikael Elí Stefánsson <mikaeleli221@gmail.com>"
  ],
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@hugsmidjan/hxmstyle": "github:hugsmidjan/hxmstyle#canary",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1"
  }
}
